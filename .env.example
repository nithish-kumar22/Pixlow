# Application — frontend base URL (e.g. for redirects and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — PostgreSQL connection string (Aiven or local); used by FastAPI and migrations
DATABASE_URL=

# Auth (Clerk) — get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWKS URL for JWT verification (e.g. https://<your-clerk-frontend-api>/.well-known/jwks.json)
CLERK_JWKS_URL=
# Clerk webhook signing secret (Dashboard → Webhooks → endpoint → Signing secret); backend only
CLERK_WEBHOOK_SECRET=

# LLM — backend only; never expose to client. Get key from https://openrouter.ai
OPENROUTER_API_KEY=
# Optional; default openai/gpt-4o-mini
OPENROUTER_MODEL_ID=

# Backend API — FastAPI base URL; set in frontend env so app can call the API
NEXT_PUBLIC_API_URL=http://localhost:8000
