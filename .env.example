# Application — frontend base URL (e.g. for redirects and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — PostgreSQL connection string (Aiven or local); used by FastAPI and migrations
DATABASE_URL=

# Auth — JWT signing secret (backend only). Use a strong random string.
JWT_SECRET=

# LLM — backend only; never expose to client. Get key from https://openrouter.ai
OPENROUTER_API_KEY=
# Optional; default openai/gpt-4o-mini
OPENROUTER_MODEL_ID=

# Backend API — FastAPI base URL; set in frontend env so app can call the API
NEXT_PUBLIC_API_URL=http://localhost:8000
